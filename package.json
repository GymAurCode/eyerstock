{
  "name": "eyerstock",
  "productName": "EyerStock",
  "version": "1.0.2",
  "private": true,
  "description": "Offline-first inventory, finance and service management for water purification businesses",
  "author": {
    "name": "Eyercall",
    "email": "support@eyerstock.local"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GymAurCode-eyerstock.git"
  },
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "npm run build:main && npm run native && cross-env NODE_ENV=development LICENCE_DISABLED=1 electron .",
    "build:main": "tsc -p tsconfig.build.json",
    "build:main:prod": "npm run build:main && node scripts/obfuscate-main.js",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "build:prod": "npm run build:main:prod && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "native": "node scripts/build-native.js",
    "pretest": "npm run native",
    "test": "vitest run",
    "pretest:watch": "npm run native",
    "test:watch": "vitest",
    "test:perf": "npm run native && vitest run --config vitest.perf.config.ts",
    "test:e2e": "npm run build && npm run native && playwright test",
    "test:e2e:ui": "npm run build && npm run native && playwright test --ui",
    "electron:fetch": "node scripts/fetch-electron.js",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3-multiple-ciphers",
    "rebuild:node": "npm rebuild better-sqlite3-multiple-ciphers",
    "db:inspect": "node scripts/inspect-db.js",
    "icons": "node scripts/make-icon.js",
    "preview:print": "tsc tools/print-preview/preview.ts --module CommonJS --target ES2022 --moduleResolution Node --outDir .tmp/print-preview --skipLibCheck --esModuleInterop --types node && electron .tmp/print-preview/preview.js",
    "preview:samples": "tsx tools/print-preview/sample-documents.ts print-preview-out",
    "dist": "npm run native && npm run build:prod && npm run icons && electron-builder --win nsis",
    "dist:dir": "npm run native && npm run build:prod && npm run icons && electron-builder --win --dir",
    "dist:verify": "node scripts/verify-installer.js",
    "release:check": "node scripts/release-check.js",
    "dist:release": "npm run release:check && npm run dist && npm run dist:verify",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run test:perf && npm run build && npm run dist:verify",
    "keygen:init": "tsx tools/keygen/index.ts init",
    "keygen": "tsx tools/keygen/index.ts",
    "keygen:verify": "tsx tools/keygen/index.ts verify",
    "keygen:inspect": "tsx tools/keygen/index.ts inspect",
    "keygen:check": "tsx tools/keygen/index.ts check"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@radix-ui/react-accordion": "^1.2.21",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-progress": "^1.1.17",
    "@radix-ui/react-radio-group": "^1.4.8",
    "@radix-ui/react-scroll-area": "^1.3.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-toggle-group": "^1.1.20",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-table": "^9.2.8",
    "@tanstack/react-virtual": "^3.14.13",
    "better-sqlite3": "^12.2.0",
    "better-sqlite3-multiple-ciphers": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.54.0",
    "qrcode": "^1.5.4",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "build": {
    "appId": "com.minha.inventory",
    "productName": "EyerStock",
    "copyright": "Copyright (c) Eyercall",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "build/icon.ico",
      "package.json",
      "!**/*.map",
      "!**/*.ts",
      "!tools/**/*"
    ],
    "extraMetadata": {
      "main": "dist/main/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EyerStock",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "language": "1033"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": true
    },
    "publish": {
      "provider": "github",
      "owner": "GymAurCode",
      "repo": "eyerStock"
    }
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/rebuild": "^4.2.1",
    "@playwright/test": "^1.64.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^38.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "javascript-obfuscator": "^5.9.0",
    "postcss": "^8.5.29",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vite": "^7.1.1",
    "vitest": "^3.2.4"
  }
}
