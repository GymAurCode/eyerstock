{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "src/domain/**/*.ts",
    "src/data/**/*.ts"
  ],
  "exclude": ["tests/**/*", "**/*.test.ts"]
}
