# Code signing
#
# Windows code signing is configured but optional. Supply these to the
# environment before running `npm run dist` to sign the installer; without
# them the build still succeeds and SmartScreen will warn users.
#
# PFX file and password:
CSC_LINK=
CSC_KEY_PASSWORD=

# Alternative: a certificate in the Windows store, addressed by thumbprint.
WIN_CSC_LINK=
WIN_CSC_KEY_PASSWORD=

# Optional offline licence-check public key (see README, "Not built yet").
# A comma-separated list of accepted signing public keys, base64 DER.
EYERSTOCK_LICENCE_PUBLIC_KEYS=

# Set to "false" only for local unsigned builds.
EYERSTOCK_REQUIRE_SIGNING=false